<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:GumpForge.Core.Models;assembly=GumpForge.Core"
        x:Class="GumpForge.App.Views.TagCollectionWindow"
        Title="Tag &amp; Collection Manager"
        Width="750" Height="550"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#0a0a1a"
        ExtendClientAreaToDecorationsHint="False">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#c8d6e5"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#16213e"/>
            <Setter Property="Foreground" Value="#c8d6e5"/>
            <Setter Property="BorderBrush" Value="#1a1a40"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style Selector="Button.action">
            <Setter Property="Background" Value="#e94560"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#16213e"/>
            <Setter Property="Foreground" Value="#c8d6e5"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.small">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ListBoxItem:nth-child(even)">
            <Setter Property="Background" Value="#0f0f2a"/>
        </Style>
    </Window.Styles>

    <Border Padding="16">
        <DockPanel>
            <!-- Header -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="🏷️ Tag &amp; Collection Manager" FontSize="20" FontWeight="Bold" Foreground="#e94560"/>
                <TextBlock Text="Manage auto-tag rules, tags, and asset collections" FontSize="12" Foreground="#666" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Bottom buttons -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                        Spacing="8" Margin="0,12,0,0">
                <Button Classes="secondary" Content="Save Profile" Click="SaveProfile_Click"/>
                <Button Classes="action" Content="Close" Click="Close_Click"/>
            </StackPanel>

            <!-- Tabs -->
            <TabControl Background="Transparent">

                <!-- ═══ TAB 1: Auto-Tag Rules ═══ -->
                <TabItem Header="📐 Auto-Tag Rules" FontSize="13">
                    <DockPanel Margin="0,8,0,0">
                        <!-- Toolbar -->
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                            <Button Classes="action small" Content="➕ Add Rule" Click="AddRule_Click"/>
                            <Button Classes="secondary small" Content="🗑️ Delete Selected" Click="DeleteRule_Click"/>
                            <Button Classes="secondary small" Content="🔄 Reset to Defaults" Click="ResetRules_Click"/>
                            <Border Width="1" Background="#333" Margin="4,0"/>
                            <Button Classes="action small" Content="▶ Run Auto-Tagger" Click="RunAutoTagger_Click"/>
                        </StackPanel>

                        <!-- Column headers -->
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="40,80,80,*" Background="#16213e"
                              Margin="0,0,0,2">
                            <TextBlock Text="✓" FontWeight="Bold" Foreground="#e94560" FontSize="11"
                                       HorizontalAlignment="Center" Padding="4,6"/>
                            <TextBlock Grid.Column="1" Text="Start ID" FontWeight="Bold" Foreground="#e94560"
                                       FontSize="11" Padding="4,6"/>
                            <TextBlock Grid.Column="2" Text="End ID" FontWeight="Bold" Foreground="#e94560"
                                       FontSize="11" Padding="4,6"/>
                            <TextBlock Grid.Column="3" Text="Tag" FontWeight="Bold" Foreground="#e94560"
                                       FontSize="11" Padding="4,6"/>
                        </Grid>

                        <!-- Rules list -->
                        <ListBox Name="RulesGrid" Background="#0a0a1a" BorderBrush="#1a1a40"
                                 BorderThickness="1" CornerRadius="4">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:TagRule">
                                    <Grid ColumnDefinitions="40,80,80,*" Margin="0,1">
                                        <CheckBox IsChecked="{Binding IsEnabled}" HorizontalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding StartId}" FontSize="11"
                                                 Background="#0a0a1a" Foreground="#ccc" BorderBrush="#333"
                                                 Padding="4,2" Margin="1,0"/>
                                        <TextBox Grid.Column="2" Text="{Binding EndId}" FontSize="11"
                                                 Background="#0a0a1a" Foreground="#ccc" BorderBrush="#333"
                                                 Padding="4,2" Margin="1,0"/>
                                        <TextBox Grid.Column="3" Text="{Binding Tag}" FontSize="11"
                                                 Background="#0a0a1a" Foreground="#aad6a5" BorderBrush="#333"
                                                 Padding="4,2" Margin="1,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                </Style>
                            </ListBox.Styles>
                        </ListBox>
                    </DockPanel>
                </TabItem>

                <!-- ═══ TAB 2: Tag Manager ═══ -->
                <TabItem Header="🏷️ Tag Manager" FontSize="13">
                    <Grid ColumnDefinitions="200,8,*" Margin="0,8,0,0">
                        <!-- Left: Tag list -->
                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Text="All Tags" FontWeight="Bold" FontSize="12"
                                       Foreground="#e94560" Margin="0,0,0,6"/>
                            <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,6,0,0">
                                <Button Classes="secondary small" Content="Rename Tag..." Click="RenameTag_Click"
                                        HorizontalAlignment="Stretch"/>
                                <Button Classes="secondary small" Content="🗑️ Delete Tag" Click="DeleteTag_Click"
                                        HorizontalAlignment="Stretch" Foreground="#f66"/>
                            </StackPanel>
                            <ListBox Name="TagList" Background="#12122a" BorderBrush="#1a1a40"
                                     BorderThickness="1" CornerRadius="4"
                                     SelectionChanged="TagList_SelectionChanged">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="FontSize" Value="11"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:selected">
                                        <Setter Property="Background" Value="#2a1a40"/>
                                    </Style>
                                </ListBox.Styles>
                            </ListBox>
                        </DockPanel>

                        <!-- Right: Assets with selected tag -->
                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Name="TagAssetCount"
                                       Text="Select a tag to see assets" FontWeight="Bold" FontSize="12"
                                       Foreground="#888" Margin="0,0,0,6"/>
                            <Button DockPanel.Dock="Bottom" Classes="secondary small"
                                    Content="Remove tag from all shown assets" Click="RemoveTagFromAll_Click"
                                    Margin="0,6,0,0" HorizontalAlignment="Stretch"/>
                            <ListBox Name="TagAssetList" Background="#12122a" BorderBrush="#1a1a40"
                                     BorderThickness="1" CornerRadius="4">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="6,3"/>
                                        <Setter Property="FontSize" Value="11"/>
                                    </Style>
                                </ListBox.Styles>
                            </ListBox>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <!-- ═══ TAB 3: Collection Manager ═══ -->
                <TabItem Header="📁 Collections" FontSize="13">
                    <Grid ColumnDefinitions="200,8,*" Margin="0,8,0,0">
                        <!-- Left: Collection list -->
                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Text="Collections" FontWeight="Bold" FontSize="12"
                                       Foreground="#e94560" Margin="0,0,0,6"/>
                            <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,6,0,0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Name="NewCollectionName" PlaceholderText="New name..." FontSize="10"/>
                                    <Button Grid.Column="1" Classes="action small" Content="+" Margin="4,0,0,0"
                                            Click="AddCollection_Click"/>
                                </Grid>
                                <Button Classes="secondary small" Content="Rename..." Click="RenameCollection_Click"
                                        HorizontalAlignment="Stretch"/>
                                <Button Classes="secondary small" Content="🗑️ Delete" Click="DeleteCollection_Click"
                                        HorizontalAlignment="Stretch" Foreground="#f66"/>
                            </StackPanel>
                            <ListBox Name="CollectionList" Background="#12122a" BorderBrush="#1a1a40"
                                     BorderThickness="1" CornerRadius="4"
                                     SelectionChanged="CollectionList_SelectionChanged">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="FontSize" Value="11"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:selected">
                                        <Setter Property="Background" Value="#2a1a40"/>
                                    </Style>
                                </ListBox.Styles>
                            </ListBox>
                        </DockPanel>

                        <!-- Right: Assets in collection -->
                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Name="CollectionAssetCount"
                                       Text="Select a collection to see assets" FontWeight="Bold" FontSize="12"
                                       Foreground="#888" Margin="0,0,0,6"/>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                <Button Classes="secondary small" Content="Remove selected from collection"
                                        Click="RemoveFromCollection_Click"/>
                                <Button Classes="secondary small" Content="Clear all" Click="ClearCollection_Click"
                                        Foreground="#f66"/>
                            </StackPanel>
                            <ListBox Name="CollectionAssetList" Background="#12122a" BorderBrush="#1a1a40"
                                     BorderThickness="1" CornerRadius="4" SelectionMode="Multiple">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="6,3"/>
                                        <Setter Property="FontSize" Value="11"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:selected">
                                        <Setter Property="Background" Value="#2a1a40"/>
                                    </Style>
                                </ListBox.Styles>
                            </ListBox>
                        </DockPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</Window>
